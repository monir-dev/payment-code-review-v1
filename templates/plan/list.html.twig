{% extends 'base.html.twig' %}

{% block title %}Available Plans{% endblock %}

{% block body %}
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h1 class="h2">
                        <i class="fas fa-list-alt text-primary"></i>
                        Subscription Plans
                    </h1>
                    <a href="{{ path('app_plan_create') }}" class="btn btn-primary">
                        <i class="fas fa-plus-circle"></i> Create Plan
                    </a>
                </div>

                {% if plans|length > 0 %}
                    <div class="row">
                        {% for plan in plans %}
                            <div class="col-lg-6 col-xl-4 mb-4">
                                <div class="card h-100 {% if plan.status.value == 'active' %}border-success{% else %}border-warning{% endif %}">
                                    <!-- Plan Header -->
                                    <div class="card-header {% if plan.status.value == 'active' %}bg-success text-white{% else %}bg-warning text-dark{% endif %}">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <h5 class="card-title mb-1">{{ plan.name }}</h5>
                                            </div>
                                            <span class="badge {% if plan.status.value == 'active' %}bg-light text-success{% else %}bg-light text-warning{% endif %} ms-2">
                                                {% if plan.status.value == 'active' %}
                                                    <i class="fas fa-check-circle"></i> Active
                                                {% else %}
                                                    <i class="fas fa-pause-circle"></i> Inactive
                                                {% endif %}
                                            </span>
                                        </div>
                                    </div>

                                    <!-- Plan Body -->
                                    <div class="card-body">
                                        <!-- Amount and Frequency -->
                                        <div class="text-center mb-3">
                                            <h2 class="text-primary mb-0">
                                                ${{ plan.amount.amount|number_format(2) }}
                                            </h2>
                                            <small class="text-muted">per {{ plan.billingCycle.frequency }}</small>
                                        </div>

                                        <!-- Plan Details -->
                                        <div class="row g-2 mb-3">
                                            <div class="col-6">
                                                <div class="bg-light p-2 rounded text-center">
                                                    <small class="text-muted d-block">Frequency</small>
                                                    <strong>{{ plan.billingCycle.frequency|title }}</strong>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="bg-light p-2 rounded text-center">
                                                    <small class="text-muted d-block">Days</small>
                                                    <strong>{{ plan.billingCycle.dayFrequency }}</strong>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Created Date -->
                                        <div class="bg-light p-2 rounded mb-3">
                                            <small class="text-muted">
                                                <i class="fas fa-calendar-alt"></i>
                                                Created: {{ plan.createdAt|date('M d, Y') }}
                                            </small>
                                        </div>
                                    </div>

                                    <!-- Plan Actions -->
                                    <div class="card-footer bg-transparent">
                                        <div class="d-grid gap-2">
                                            <form method="post" action="{{ path('app_plan_toggle_status', {'id': plan.planId.value}) }}">
                                                {% if plan.status.value == 'active' %}
                                                    <button type="submit"
                                                            class="btn btn-outline-warning btn-sm w-100"
                                                            onclick="return confirm('Deactivate this plan? It will no longer be available for new subscriptions.')">
                                                        <i class="fas fa-pause"></i> Deactivate
                                                    </button>
                                                {% else %}
                                                    <button type="submit"
                                                            class="btn btn-outline-success btn-sm w-100"
                                                            onclick="return confirm('Activate this plan? It will become available for new subscriptions.')">
                                                        <i class="fas fa-play"></i> Activate
                                                    </button>
                                                {% endif %}
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    <!-- Summary Stats -->
                    <div class="row mt-4">
                        <div class="col-md-6">
                            <div class="card border-success">
                                <div class="card-body text-center">
                                    <h3 class="text-success">
                                        {{ plans|filter(p => p.status.value == 'active')|length }}
                                    </h3>
                                    <p class="text-muted mb-0">Active Plans</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card border-warning">
                                <div class="card-body text-center">
                                    <h3 class="text-warning">
                                        {{ plans|filter(p => p.status.value == 'inactive')|length }}
                                    </h3>
                                    <p class="text-muted mb-0">Inactive Plans</p>
                                </div>
                            </div>
                        </div>
                    </div>

                {% else %}
                    <!-- Empty State -->
                    <div class="card">
                        <div class="card-body text-center py-5">
                            <div class="mb-4">
                                <i class="fas fa-clipboard-list fa-4x text-muted"></i>
                            </div>
                            <h3 class="text-muted">No Plans Created Yet</h3>
                            <p class="text-muted mb-4">
                                Create your first subscription plan to get started with recurring billing.
                            </p>
                            <a href="{{ path('app_plan_create') }}" class="btn btn-primary btn-lg">
                                <i class="fas fa-plus-circle"></i> Create Your First Plan
                            </a>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
